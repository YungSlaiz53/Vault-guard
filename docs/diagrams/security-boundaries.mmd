flowchart TB
  subgraph Untrusted["Zone 1: Untrusted External Input"]
    InvoicePDF["Vendor Invoice PDF / JSON<br/>(May contain prompt injections)"]
    FakePR["External GitHub PR URL<br/>(May be unmerged / mismatched)"]
    SpoofedTx["External Destination Tx Hash<br/>(May be spoofed / underpaid)"]
  end

  subgraph Advisory["Zone 2: Advisory Analysis & Evidence Collectors"]
    AI["NEAR AI Cloud Verifier<br/>(Advisory Recommendation Only)"]
    GH["GitHub Evidence Inspector<br/>(Independent Merge & Commit Check)"]
    Attest["Ed25519 Attestation Signer<br/>(Canonical Payload + Nonce)"]
  end

  subgraph RestrictedExec["Zone 3: Restricted Executor & Policy Layer"]
    Policy["Deterministic Policy Engine<br/>(Hard Spending Caps & Whitelists)"]
    FCKey["Restricted Function Call Key<br/>(0 NEAR Transfer Allowance)"]
    Intents["NEAR Intents 1Click Orchestrator<br/>(RPC-Verified Destination Tx)"]
  end

  subgraph OnChain["Zone 4: Authoritative On-Chain Custody & Enforcement"]
    Contract["VaultGuard Rust Smart Contract<br/>(Final Authority & Replay Guard)"]
    Vault["NEAR Treasury Custody Account<br/>(Holds Actual Token Balances)"]
  end

  InvoicePDF -->|Sanitized Delimiters| AI
  FakePR -->|REST Verification| GH
  AI & GH -->|Canonical Hash| Attest
  Attest -->|Ed25519 Signature| Policy
  Policy -->|Method-Scoped Call| FCKey
  FCKey -->|authorize_invoice_payment| Contract
  Contract -->|Reservation Token| Intents
  SpoofedTx -->|RPC Receipt Check| Intents
  Intents -->|mark_settlement_completed| Contract
  Contract <-->|Authorized Release Only| Vault
