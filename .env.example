# ==============================================================================
# VAULTGUARD — ENVIRONMENT VARIABLE CONFIGURATION (.env.example)
# ==============================================================================
# Copy to `.env` for local customization.
# All variables have safe deterministic defaults for local simulation mode.
# Never commit real private keys, API keys, or JWTs to version control.
# ==============================================================================

# Runtime & Persistence
NODE_ENV=development
APP_URL=http://localhost:3000
# Local JSON snapshot path (default) or PostgreSQL connection URI
DATABASE_URL=file:./.data/vaultguard.json

# NEAR Protocol Network & Accounts
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_TREASURY_ACCOUNT_ID=treasury-custody.vaultguard.testnet
NEAR_POLICY_CONTRACT_ID=policy-guard.vaultguard.testnet
NEAR_AGENT_ACCOUNT_ID=ai-executor.vaultguard.testnet
# Optional in simulation mode: ed25519 private key for restricted Function Call Key on NEAR Testnet
NEAR_AGENT_PRIVATE_KEY=ed25519:YOUR_RESTRICTED_FUNCTION_CALL_PRIVATE_KEY_PLACEHOLDER

# NEAR AI Cloud (Private AI Invoice Analysis)
# Optional in simulation mode: leave empty to use the deterministic local verifier
NEAR_AI_API_KEY=your_near_ai_cloud_api_key_placeholder
NEAR_AI_BASE_URL=https://api.near.ai/v1

# GitHub REST API (Independent Proof-of-Work Pull Request Verification)
# Optional in simulation mode: leave empty to use deterministic PR fixture verification
GITHUB_TOKEN=ghp_your_github_personal_access_token_placeholder

# NEAR Intents 1Click Settlement API
INTENTS_API_BASE_URL=https://1click.chaindefuser.com
# Optional in simulation mode: required only for authenticated live 1Click API calls
INTENTS_JWT=your_near_intents_1click_jwt_placeholder

# Session & Offchain AES-256-GCM Document Encryption Secret
AUTH_SECRET=replace_with_32_byte_hex_secret_for_aes_256_gcm_at_rest

# Cryptographic Verifier Attestation Keys (Ed25519)
# Optional in simulation mode: ephemeral Ed25519 keypair is generated deterministically at boot if omitted
ATTESTATION_SIGNING_KEY=302e020100300506032b657004220420_HEX_PKCS8_PRIVATE_KEY_PLACEHOLDER
ATTESTATION_TRUSTED_PUBLIC_KEY=302a300506032b6570032100_HEX_SPKI_PUBLIC_KEY_PLACEHOLDER

# Payment Execution Mode Guardrails
# Allowed: "simulation" (default, safe local simulation) | "mainnet" (requires ENABLE_REAL_PAYMENTS=true)
PAYMENT_MODE=simulation
ENABLE_REAL_PAYMENTS=false
