{
  "name": "vaultguard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/adversarial/*.test.ts",
    "test:contract": "tsx cli/src/index.ts test:contract",
    "test:security": "tsx --test tests/adversarial/*.test.ts",
    "test:valid-invoice": "tsx cli/src/index.ts test:valid-invoice",
    "test:prompt-injection": "tsx cli/src/index.ts test:prompt-injection",
    "test:spend-limit": "tsx cli/src/index.ts test:spend-limit",
    "test:daily-limit": "tsx cli/src/index.ts test:daily-limit",
    "test:duplicate-invoice": "tsx cli/src/index.ts test:duplicate-invoice",
    "test:attestation": "tsx cli/src/index.ts test:attestation",
    "test:vendor-whitelist": "tsx cli/src/index.ts test:vendor-whitelist",
    "test:concurrency": "tsx cli/src/index.ts test:concurrency",
    "test:settlement": "tsx cli/src/index.ts test:settlement",
    "test:attack:custody": "tsx --test tests/adversarial/treasury-custody.test.ts",
    "test:attack:attestation": "tsx --test tests/adversarial/tee-attestation.test.ts",
    "test:attack:settlement": "tsx --test tests/adversarial/intents-settlement.test.ts",
    "test:attack:all": "tsx cli/src/index.ts test:attack:all",
    "demo": "tsx cli/src/index.ts demo"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
